# Copy this file to .env and fill in your key.
# Get one at https://console.anthropic.com/settings/keys
# Speed Sketch's AI judging will not work without this set.
ANTHROPIC_API_KEY=your-key-here

# Pick any password of your choosing — this protects your private usage
# dashboard at yoursite.com/admin?key=whatever-you-set-here. Don't share it.
ADMIN_KEY=...........

